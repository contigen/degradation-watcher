flowchart TD
    CS["Cloud Scheduler\n5-day cadence\n0 2 */5 * *"]
    IS["Imagery Service\nFastAPI / Cloud Run\nSentinel-2 + NDVI + Downsampling"]
    STAC["AWS Element84 STAC\nSentinel-2 L2A\nFree / Open Access"]
    GCS["Google Cloud Storage\nWeb PNGs + Raw TIFs\ngs://bucket/imagery/"]
    PS_IR["Pub/Sub\nimagery-ready"]

    OA["Orchestrator Agent\nADK TypeScript\nCloud Run"]
    
    PS_CE["Pub/Sub\ncontext-enricher-trigger"]
    PS_RS["Pub/Sub\nrisk-scorer-trigger"]
    PS_RD["Pub/Sub\nresponse-drafter-trigger"]

    CEA["Context Enricher Agent\nADK TypeScript / Cloud Run\nOpen-Meteo + USGS API"]
    RSA["Risk Scorer Agent\nADK TypeScript / Cloud Run\nClamped 0-100 score"]
    RDA["Response Drafter Agent\nADK TypeScript / Cloud Run\nMitigation report drafter"]

    USGS["USGS Earthquake API\nSeismic proximity"]
    OM["Open-Meteo API\nWeather & soil moisture"]
    GEMINI["Gemini 3.6 Flash\nVertex AI / Google GenAI\nMultimodal temporal diffing"]

    FS[("Firestore Database\nAsset registry\nDegradation records\nRisk scores / Alerts")]
    WEB["Next.js 16 Dashboard\nGeist Mono / Server Components\nInteractive diffing & Timeline"]

    CS -->|HTTP POST /run| IS
    IS -->|STAC search| STAC
    IS -->|upload optimized PNGs| GCS
    IS -->|publish| PS_IR
    PS_IR -->|push| OA
    OA -->|publish| PS_CE
    OA -->|publish| PS_RS
    OA -->|A2A| RDA
    PS_CE -->|push| CEA
    CEA --> USGS
    CEA --> OM
    CEA -->|write context| FS
    PS_RS -->|push| RSA
    RSA -->|read| FS
    RSA -->|write clamped score| FS
    RSA -->|if threshold exceeded| PS_RD
    PS_RD -->|push| RDA
    RDA --> GEMINI
    RDA -->|write alert + report| FS
    OA --> GEMINI
    GEMINI -->|temporal diffing| GCS
    WEB -->|server component + listeners| FS

    style GEMINI fill:#1e1b4b,color:#fff,stroke:#4338ca
    style FS fill:#431407,color:#fff,stroke:#9a3412
    style WEB fill:#042f2e,color:#fff,stroke:#0d9488
    style IS fill:#052e16,color:#fff,stroke:#15803d
    style OA fill:#0f172a,color:#fff,stroke:#3b82f6
    style CEA fill:#0f172a,color:#fff,stroke:#3b82f6
    style RSA fill:#0f172a,color:#fff,stroke:#3b82f6
    style RDA fill:#0f172a,color:#fff,stroke:#3b82f6
