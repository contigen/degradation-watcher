# ============================================================
# Degradation Watcher — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ── GCP Core ────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-project-imagery

# ── Pub/Sub Topics ──────────────────────────────────────────
IMAGERY_TOPIC=imagery-ready
CONTEXT_ENRICHER_TOPIC=context-enricher-trigger
ANALYST_TOPIC=analyst-trigger
RISK_SCORER_TOPIC=risk-scorer-trigger
RISK_RESULT_TOPIC=risk-result
RESPONSE_DRAFTER_TOPIC=response-drafter-trigger

# ── Firebase (Next.js web app) ───────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── External APIs (all free) ─────────────────────────────────
# NOAA CDO API — register at https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_TOKEN=your-noaa-token

# USDA NASS — register at https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=your-usda-key

# Open-Meteo — no key required (leave blank)
# USGS Earthquake — no key required (leave blank)
# AWS Element84 STAC — no key required (leave blank)

# ── Google Earth Engine (optional, for NAIP + NDVI) ──────────
# Auth via: earthengine authenticate
# Then: earthengine set_project your-gcp-project-id
# No env var needed — uses ADC (Application Default Credentials)
